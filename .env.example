# Copy to .env.local (Next) and/or .dev.vars (Wrangler preview)

MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=

# Auth.js — required for magic-link sign-in
AUTH_SECRET=

# Optional: send magic links via Resend. Without this, links are logged only.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=onboarding@resend.dev

# Public site URL for payment notify/return (production required)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local mock pay (checkout channel=mock). Dev NODE_ENV also allows mock.
# NEXT_PUBLIC_PAY_ALLOW_MOCK=1
# PAY_ALLOW_MOCK=1
PAY_MOCK_SECRET=inkara-mock-pay

# WeChat Pay APIv3 Native (扫码)
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_SERIAL=
# WECHAT_PAY_PRIVATE_KEY=
# WECHAT_PAY_API_V3_KEY=
# Optional: platform cert public key for notify verify
# WECHAT_PAY_PLATFORM_PUBLIC_KEY=

# Alipay 电脑网站支付 (page.pay)
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# Cloudflare bindings (wrangler.jsonc — not env vars):
#   DB → D1 database "inkara"
#   AI → Workers AI (@cf/baai/bge-m3)
#   VECTORIZE → index "inkara-pages" (1024-d cosine)
# Local/preview: use `npm run preview` / deploy so bindings exist.
# Types: `npm run cf-typegen` (output gitignored).

# Speech-to-text (type-mode mic). Prefer DASHSCOPE_API_KEY for Paraformer.
# DASHSCOPE_API_KEY=
# STT_TICKET_SECRET=   # falls back to AUTH_SECRET
# NEXT_PUBLIC_STT_WS_URL=ws://127.0.0.1:8787
