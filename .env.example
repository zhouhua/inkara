# Copy to .env.local (Next) and/or .dev.vars (Wrangler preview)
#
# ECS / Node production (not used on Cloudflare):
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/inkara
# EMBEDDING_MODEL=text-embedding-v3

MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=

# Auth.js — required for magic-link sign-in AND signed anonymous cookies
AUTH_SECRET=

# Optional: send magic links via Resend. Without this, links are logged only.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM=onboarding@resend.dev

# Comma-separated emails promoted to admin on login (role=admin)
# Shared by product + apps/admin (same /etc/inkara.env on ECS).
# ADMIN_EMAILS=you@example.com

# Admin public URL (ECS systemd overrides AUTH_URL; local admin uses :3001)
# ECS_ADMIN_PUBLIC_URL=https://admin.inkara.zhouhua.site

# WeChat Open Platform website app (QR login). Without these, UI shows 未配置.
# WECHAT_OPEN_APP_ID=
# WECHAT_OPEN_APP_SECRET=

# Aliyun Dysms SMS OTP. Without these, OTP is logged server-side only.
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=

# Public site URL for payment notify/return (production required)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local mock pay (checkout channel=mock). Dev NODE_ENV also allows mock.
# NEXT_PUBLIC_PAY_ALLOW_MOCK=1
# PAY_ALLOW_MOCK=1
PAY_MOCK_SECRET=inkara-mock-pay

# WeChat Pay APIv3 Native (扫码)
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_SERIAL=
# WECHAT_PAY_PRIVATE_KEY=
# WECHAT_PAY_API_V3_KEY=
# Required in production for notify signature verify
# WECHAT_PAY_PLATFORM_PUBLIC_KEY=

# Alipay 电脑网站支付 (page.pay)
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# Cloudflare bindings (wrangler.jsonc — not env vars):
#   DB → D1 database "inkara"
#   AI → Workers AI (@cf/baai/bge-m3)
#   VECTORIZE → index "inkara-pages" (1024-d cosine)
# Local/preview: use `pnpm preview` / deploy so bindings exist.
# Types: `pnpm cf-typegen` (output gitignored).

# Speech-to-text (type-mode mic). Prefer DASHSCOPE_API_KEY for Paraformer.
# DASHSCOPE_API_KEY=
# STT_TICKET_SECRET=   # falls back to AUTH_SECRET
# NEXT_PUBLIC_STT_WS_URL=ws://127.0.0.1:8787
